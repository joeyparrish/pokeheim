<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>Pokeheim</AssemblyName>
    <RootNamespace>Pokeheim</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- Pokeheim.cs declares the assembly attributes by hand, because
         AssemblyVersion is built from ModVersion.String, which the
         GenerateVersionFile target writes for release builds.  Stop the SDK
         from generating a second, conflicting set. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- We list every source file explicitly below.  During the staged revival
         this is load-bearing: a feature that has not been brought back yet is
         simply absent from the Compile list, so it cannot break the build. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>

    <!-- Gates Jotunn's JotunnBuildTask, which publicizes the game assemblies.
         Normally supplied by ../DoPrebuild.props, repeated here so that
         building this project directly (rather than the solution) also
         works. -->
    <ExecutePrebuild Condition="'$(ExecutePrebuild)' == ''">true</ExecutePrebuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <CoreCompileDependsOn>GenerateVersionFile;$(CoreCompileDependsOn)</CoreCompileDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jotunn brings BepInEx, HarmonyX and MonoMod in transitively, and its
         build/ props publicize the game assemblies for us.  There is no
         packages.config and no packages/ directory any more. -->
    <PackageReference Include="JotunnLib" Version="2.30.0" />
    <!-- Needed to target .NET Framework on Linux, where the reference
         assemblies are not installed system-wide. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jotunn's reference list includes UnityEngine.ProfilerModule, which
         this version of the game does not ship.  It is only ever a warning,
         because nothing we build actually uses it, so drop the reference
         rather than silencing the warning. -->
    <Reference Remove="UnityEngine.ProfilerModule" />
  </ItemGroup>

  <ItemGroup>
    <!-- Grants access to the publicized game assemblies. -->
    <Compile Include="Properties\IgnoreAccessModifiers.cs" />

    <!-- Always present: the plugin entry point, the feature registry that
         decides what gets patched, and shared helpers. -->
    <Compile Include="Pokeheim.cs" />
    <Compile Include="Features.cs" />
    <Compile Include="TranspilerSequence.cs" />
    <Compile Include="Utils.cs" />

    <!-- Stage 0 features. -->
    <Compile Include="MenuVersion.cs" />
    <Compile Include="MusicMods.cs" />
    <Compile Include="Pokedex.cs" />

    <!-- Features still to be revived.  Uncomment as each stage brings one
         back, together with its section of testing-script.md.  See
         docs/superpowers/specs/2026-09-04-pokeheim-revival-design.md.
    <Compile Include="BallItem.cs" />
    <Compile Include="BallProjectile.cs" />
    <Compile Include="Berries.cs" />
    <Compile Include="BossMods.cs" />
    <Compile Include="Captured.cs" />
    <Compile Include="ContainerMods.cs" />
    <Compile Include="Credits.cs" />
    <Compile Include="Debugging.cs" />
    <Compile Include="DressUp.cs" />
    <Compile Include="Fainting.cs" />
    <Compile Include="Giovanni.cs" />
    <Compile Include="Inhabitant.cs" />
    <Compile Include="InventoryMods.cs" />
    <Compile Include="MonsterWithWeapons.cs" />
    <Compile Include="OdinMods.cs" />
    <Compile Include="PlayerMods.cs" />
    <Compile Include="ProfessorRaven.cs" />
    <Compile Include="Riding.cs" />
    <Compile Include="SerpentMods.cs" />
    <Compile Include="ShinyMods.cs" />
    <Compile Include="Sounds.cs" />
    <Compile Include="Suppressipes.cs" />
    -->
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>

  <!-- Bakes the release version into the assembly.  Only runs for Release
       builds, via CoreCompileDependsOn above. -->
  <Target Name="GenerateVersionFile">
    <PropertyGroup>
      <ReleaseVersionCode>
namespace Pokeheim {
  public static class ModVersion {
    public const string String = "$(RELEASE_VERSION)"%3B
  }
}
      </ReleaseVersionCode>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)ReleaseVersion.g.cs" Lines="$(ReleaseVersionCode)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ReleaseVersion.g.cs" />
    </ItemGroup>
  </Target>

  <Target Name="EnsureEnvironmentPropsImport" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>This project needs an Environment.props file with the path to your Valheim installation. See https://github.com/Valheim-Modding/JotunnModStub. {0} is missing.</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../Environment.props')" Text="$([System.String]::Format('$(ErrorText)', 'Environment.props'))" />
  </Target>

</Project>
